# Copy to `.env` (or `.env.local`) and fill in. Expo inlines EXPO_PUBLIC_* vars
# at build time; they are read into expo.extra by app.config.ts and consumed by
# src/config/env.ts. No secrets are hardcoded in source.

# Backend base URL the app talks to (FastAPI: web/server.py).
#   Local dev:  http://localhost:8000  (iOS simulator can reach localhost)
#   Android emulator reaching a host-machine backend: http://10.0.2.2:8000
#   Production: your deployed HTTPS host, e.g. https://api.example.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth (GoTrue) — REQUIRED for sign-in. The app opens the LoginScreen
# until a session exists, and run creation now hits the authenticated
# POST /api/v2/runs (web/mobile/router.py). Without these two values the login
# screen shows a "Supabase isn't configured" message and runs can't start.
# Use the same project URL the backend uses; the anon/publishable key is safe to
# ship in a client (it is NOT the service-role key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
