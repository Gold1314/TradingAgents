# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# In the CLI, setting the LLM provider / models / backend URL / language
# also skips the matching interactive selection step (useful for
# OpenAI-compatible endpoints like opencode or LM Studio, and unattended runs).
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# Sampling temperature (lower = less run-to-run variation on models that
# honor it). Unset leaves each provider at its default. See the README
# "Reproducibility" note — no setting makes LLM output fully deterministic.
#TRADINGAGENTS_TEMPERATURE=0.0

# ── Robinhood Trading MCP (live brokerage; additive & OFF by default) ──────────
# Connects the agent pipeline to your Robinhood Agentic account via the
# Robinhood Trading MCP (https://agent.robinhood.com/mcp/trading). The whole
# layer is inert unless ENABLED=true.
#
#   - GROUNDING=true → inject your real positions & buying power into the agents
#   - TRADE_MODE     → how the rating becomes an order:
#       off    = grounding only, never place an order
#       manual = propose the order; YOU place it via the "Place order" button (default)
#       auto   = place the order automatically right after the verdict
#   - DRY_RUN=true   → simulate orders only (no order leaves the building)
#
# A real order requires TRADE_MODE in {manual,auto} AND DRY_RUN=false. In manual
# mode the button click is your confirmation; in auto mode orders fire with NO
# per-trade confirmation. You are responsible for every trade your agent places.
# Start with DRY_RUN=true to rehearse safely.
#TRADINGAGENTS_ROBINHOOD_ENABLED=false
#TRADINGAGENTS_ROBINHOOD_GROUNDING=true
#TRADINGAGENTS_ROBINHOOD_TRADE_MODE=manual
#TRADINGAGENTS_ROBINHOOD_DRY_RUN=true
#TRADINGAGENTS_ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
#TRADINGAGENTS_ROBINHOOD_MAX_ORDER_NOTIONAL=1000
#TRADINGAGENTS_ROBINHOOD_DEFAULT_ORDER_NOTIONAL=100
#TRADINGAGENTS_ROBINHOOD_ORDER_TYPE=market
#TRADINGAGENTS_ROBINHOOD_TOKEN_PATH=~/.tradingagents/robinhood_token.json
#TRADINGAGENTS_ROBINHOOD_CALLBACK_PORT=8765

# ── Mobile (iOS) API — additive & OFF by default ──────────────────────────────
# The versioned /api/v2/* surface for the native iOS app lives in web/mobile/
# and is registered ONLY when MOBILE_API_ENABLED=true. With it unset (default),
# the web app behaves exactly as before: no auth enforcement, no rate limiting,
# no mobile OAuth, and the legacy single-user broker path is the only one used.
#MOBILE_API_ENABLED=false
#
# Auth for v2 endpoints. "dev" (default) uses a built-in HMAC bearer-token layer
# (mint with web.mobile.auth.mint_dev_token) — NOT for production. "supabase" is
# the production identity provider: it verifies Supabase Auth (GoTrue) access
# tokens (signature + exp/nbf/iat + aud + iss). Switching is a pure config change.
#MOBILE_AUTH_MODE=dev
#MOBILE_AUTH_SECRET=                 # HMAC secret for dev tokens (falls back to SUPABASE_KEY / admin pw)
#
# ── Supabase Auth (the real IdP; used when MOBILE_AUTH_MODE=supabase) ──────────
# Requires `pip install 'pyjwt[crypto]'`. SUPABASE_URL is reused from the
# persistence layer (web/db.py); the issuer and JWKS endpoint are derived from
# it. Configure at least one verification path (HS256 secret or JWKS).
#SUPABASE_URL=https://<project-ref>.supabase.co
#SUPABASE_JWT_SECRET=                # legacy HS256 signing secret (Project → API → JWT Secret)
#SUPABASE_JWT_AUD=authenticated      # expected `aud` claim (default: authenticated)
#SUPABASE_JWT_ISSUER=                # expected `iss`; default <SUPABASE_URL>/auth/v1
#SUPABASE_JWKS_ENABLED=true          # RS256/ES256 via JWKS; default ON when SUPABASE_URL is set
#SUPABASE_JWKS_URL=                  # override; default <SUPABASE_URL>/auth/v1/.well-known/jwks.json
#
# Per-user run quota on POST /api/v2/runs (0 = unlimited for that window).
#MOBILE_RUNS_PER_HOUR=10
#MOBILE_RUNS_PER_DAY=50
# Per-user order quota on POST /api/v2/runs/{id}/orders (0 = unlimited).
#MOBILE_ORDERS_PER_HOUR=30
#MOBILE_ORDERS_PER_DAY=200
#
# TEST/DEV ONLY (default OFF): swap the per-user broker for an in-memory fake so
# the trading UI (connect status, account snapshot, order ticket + biometric
# gate) can be exercised WITHOUT live Robinhood. Never touches the network and
# never places a real order, even with dry_run=false. Do NOT set in production.
# See docs/ios-app-testing.md §C.
#MOBILE_FAKE_BROKER=false
#
# Server-mediated Robinhood OAuth (§5.1.3). The redirect Robinhood sees is
# <MOBILE_PUBLIC_BASE_URL>/api/v2/robinhood/callback — a remote HTTPS endpoint we
# own (NOT localhost). One env value flips dev/staging/prod.
#MOBILE_PUBLIC_BASE_URL=https://your-domain.example.com
#MOBILE_OAUTH_APP_REDIRECT=stockagents://oauth/robinhood
#MOBILE_TOKEN_DIR=~/.tradingagents/tokens   # per-user broker token storage dir

# ── Voice-conversational layer — additive & OFF by default ─────────────────────
# After a 12-agent run finishes, users can tap any agent card on web/iOS/RN
# and enter a real-time WebRTC voice call with that agent. The feature is
# wired through web/voice/ (FastAPI router) + tradingagents/voice/ (LiveKit
# Agents worker). See docs/voice-cost-model.md for unit prices and budgets.
#
# Master switch (default false). Voice also self-disables if any of the
# transport credentials below are missing.
#TRADINGAGENTS_VOICE_ENABLED=false
#
# LiveKit Cloud (https://livekit.io) — WebRTC transport. The API secret signs
# the room JWT minted by web/voice/jwt.py and is also read by the worker
# process when it registers with the LiveKit server.
#LIVEKIT_URL=wss://your-project.livekit.cloud
#LIVEKIT_API_KEY=
#LIVEKIT_API_SECRET=
#
# Deepgram (https://deepgram.com) — streaming ASR. Nova-3 is the v1 default;
# Nova-2 also works.
#DEEPGRAM_API_KEY=
#DEEPGRAM_MODEL=nova-3
#
# ElevenLabs (https://elevenlabs.io) — TTS, 12 distinct branded voices. The
# voice IDs per persona live in tradingagents/voice/personas.py; override
# individual personas with TRADINGAGENTS_VOICE_OVERRIDE_<AGENT_KEY>=<voice-id>
# (e.g. TRADINGAGENTS_VOICE_OVERRIDE_BULL_RESEARCHER=...).
#ELEVENLABS_API_KEY=
#ELEVENLABS_MODEL=eleven_flash_v2_5
#
# Hot-swappable TTS alternative. Default is elevenlabs; set to cartesia to
# use Cartesia Sonic (also installs livekit-plugins-cartesia).
#TRADINGAGENTS_VOICE_TTS_PROVIDER=elevenlabs
#CARTESIA_API_KEY=
#
# Voice agent "brain" — the LLM that drives turn-by-turn replies. Voice favors
# low-latency chat models, NOT the deep reasoning model used by the run
# pipeline. Defaults to OpenAI gpt-4o-mini. Supported providers: openai,
# anthropic, google, openrouter.
#TRADINGAGENTS_VOICE_LLM_PROVIDER=openai
#TRADINGAGENTS_VOICE_LLM_MODEL=gpt-4o-mini
#
# Cost & abuse guardrails (Phase 6). Defaults are conservative; see the
# cost model doc for worked examples.
#TRADINGAGENTS_VOICE_SESSION_MAX_SECONDS=600        # hard cap per call (10 min)
#TRADINGAGENTS_VOICE_MINUTES_PER_USER_PER_DAY=30     # rolling 24h voice budget
#TRADINGAGENTS_VOICE_SESSIONS_PER_USER_PER_HOUR=12   # burst cap
#TRADINGAGENTS_VOICE_TOKEN_TTL_SECONDS=1800          # room JWT lifetime
#
# Unit price overrides (USD). Update these to track your contract rates;
# they are passed to web/voice/db.py for the cost dashboard rollups.
#TRADINGAGENTS_VOICE_PRICE_ASR_PER_SECOND=0.0000717
#TRADINGAGENTS_VOICE_PRICE_TTS_PER_SECOND=0.003
#TRADINGAGENTS_VOICE_PRICE_LLM_INPUT_PER_1K=0.00015
#TRADINGAGENTS_VOICE_PRICE_LLM_OUTPUT_PER_1K=0.00060
